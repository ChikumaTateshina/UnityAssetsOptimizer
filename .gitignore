.DS_Store
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.user
*.suo

# Unity（リポジトリ直下やテスト用に Unity プロジェクトとして開いた場合）
/[Aa]ssets/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
